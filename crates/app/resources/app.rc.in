#include <winver.h>

#define RT_MANIFEST 24

1 ICON "@ICON@"
1 RT_MANIFEST "@MANIFEST@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @VERSION_NUM@
PRODUCTVERSION @VERSION_NUM@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "noartem"
            VALUE "FileDescription", "Taskbar Monitor"
            VALUE "FileVersion", "@VERSION@"
            VALUE "InternalName", "taskbar-monitor"
            VALUE "OriginalFilename", "taskbar-monitor.exe"
            VALUE "ProductName", "Taskbar Monitor"
            VALUE "ProductVersion", "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
